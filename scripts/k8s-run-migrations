#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(dirname "$script_dir")
kubectl_ooh="$script_dir/kubectl-ooh-test"
job_name="db-migrate"
migration_timeout="${OOH_K8S_MIGRATION_TIMEOUT:-300s}"

"$kubectl_ooh" rollout status statefulset/postgres --timeout="$migration_timeout"

if "$kubectl_ooh" get job "$job_name" >/dev/null 2>&1; then
    active=$(
        "$kubectl_ooh" get job "$job_name" \
            -o jsonpath='{.status.active}'
    )
    if [ "${active:-0}" -ne 0 ]; then
        echo "migration Job '$job_name' is already active; refusing to replace it" >&2
        exit 1
    fi
    "$kubectl_ooh" delete job "$job_name" --wait=true
fi

"$kubectl_ooh" create -k "$repository_root/k8s/jobs"

if ! "$kubectl_ooh" wait \
    --for=condition=complete \
    "job/$job_name" \
    --timeout="$migration_timeout"
then
    "$kubectl_ooh" describe "job/$job_name" >&2 || true
    "$kubectl_ooh" logs "job/$job_name" >&2 || true
    exit 1
fi

"$kubectl_ooh" logs "job/$job_name"
