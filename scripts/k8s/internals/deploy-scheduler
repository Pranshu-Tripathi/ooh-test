#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "$script_dir/../../.." && pwd)
kubectl_ooh="$script_dir/kubectl-ooh-test"
rollout_timeout="${OOH_K8S_ROLLOUT_TIMEOUT:-300s}"
migrations_complete=false

case "${1:-}" in
    "")
        ;;
    --migrations-complete)
        migrations_complete=true
        ;;
    *)
        echo "usage: $0 [--migrations-complete]" >&2
        exit 64
        ;;
esac

if [ "$migrations_complete" = false ]; then
    "$script_dir/run-migrations"
fi

deployment_active=false
current_replicas=$(
    "$kubectl_ooh" get deployment/scheduler \
        -o jsonpath='{.spec.replicas}' 2>/dev/null || true
)
if [ "${current_replicas:-0}" -gt 0 ]; then
    deployment_active=true
fi

"$kubectl_ooh" apply -k "$repository_root/k8s/scheduler"

if [ "$deployment_active" = true ]; then
    "$kubectl_ooh" rollout restart deployment/scheduler
fi

if ! "$kubectl_ooh" rollout status deployment/scheduler --timeout="$rollout_timeout"
then
    "$kubectl_ooh" describe deployment/scheduler >&2 || true
    "$kubectl_ooh" get pods \
        -l app.kubernetes.io/component=scheduler \
        -o wide >&2 || true
    "$kubectl_ooh" logs deployment/scheduler \
        --all-pods=true \
        --tail=100 >&2 || true
    exit 1
fi
