#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
port_forward_script="$script_dir/port-forward-api"
runtime_dir="${TMPDIR:-/tmp}/ooh-test-k8s"
launch_label="dev.ooh-test.k8s-port-forward"
stdout_log="$runtime_dir/api-port-forward.out.log"
stderr_log="$runtime_dir/api-port-forward.err.log"

managed_pid() {
    if ! launchctl list "$launch_label" >/dev/null 2>&1; then
        return 1
    fi

    pid=$(
        launchctl list "$launch_label" |
            awk '/"PID"/ {gsub(/;/, "", $3); print $3; exit}'
    )
    case "$pid" in
        ""|*[!0-9]*)
            return 1
            ;;
    esac

    echo "$pid"
}

start_forward() {
    if ! command -v launchctl >/dev/null 2>&1; then
        echo "launchctl is required to manage the macOS port-forward process" >&2
        exit 127
    fi
    if ! command -v curl >/dev/null 2>&1; then
        echo "curl is required to verify the API port-forward" >&2
        exit 127
    fi
    kubectl_path=$(command -v kubectl)

    if pid=$(managed_pid); then
        echo "API port-forward already running with PID $pid"
        return 0
    fi

    mkdir -p "$runtime_dir"
    if launchctl list "$launch_label" >/dev/null 2>&1; then
        launchctl remove "$launch_label"
    fi

    if command -v lsof >/dev/null 2>&1 &&
        lsof -nP -iTCP:8500 -sTCP:LISTEN >/dev/null 2>&1
    then
        echo "host port 8500 is already in use by an unmanaged process" >&2
        exit 1
    fi

    umask 077
    launchctl submit \
        -l "$launch_label" \
        -o "$stdout_log" \
        -e "$stderr_log" \
        -- \
        "$kubectl_path" \
        --context docker-desktop \
        --namespace ooh-test \
        port-forward \
        --address 127.0.0.1 \
        service/api \
        8500:8500

    attempt=0
    while [ "$attempt" -lt 30 ]
    do
        if ! pid=$(managed_pid); then
            echo "API port-forward exited during startup" >&2
            sed -n '1,80p' "$stdout_log" >&2
            sed -n '1,80p' "$stderr_log" >&2
            exit 1
        fi
        if curl --fail --silent --show-error \
            http://127.0.0.1:8500/healthz >/dev/null 2>&1
        then
            echo "API available at http://127.0.0.1:8500 (PID $pid)"
            return 0
        fi
        attempt=$((attempt + 1))
        sleep 1
    done

    echo "API port-forward did not become healthy within 30 seconds" >&2
    "$port_forward_script" stop
    sed -n '1,80p' "$stdout_log" >&2
    sed -n '1,80p' "$stderr_log" >&2
    exit 1
}

stop_forward() {
    if ! launchctl list "$launch_label" >/dev/null 2>&1; then
        echo "API port-forward is stopped"
        return 0
    fi

    launchctl remove "$launch_label"
    attempt=0
    while launchctl list "$launch_label" >/dev/null 2>&1 &&
        [ "$attempt" -lt 30 ]
    do
        attempt=$((attempt + 1))
        sleep 1
    done

    if launchctl list "$launch_label" >/dev/null 2>&1; then
        echo "API port-forward launch job did not stop" >&2
        exit 1
    fi

    echo "API port-forward stopped"
}

case "${1:-foreground}" in
    foreground)
        exec "$script_dir/kubectl-ooh-test" port-forward \
            --address 127.0.0.1 \
            service/api \
            8500:8500
        ;;
    start)
        start_forward
        ;;
    stop)
        stop_forward
        ;;
    status)
        if pid=$(managed_pid); then
            echo "API port-forward running at http://127.0.0.1:8500 (PID $pid)"
        else
            echo "API port-forward is stopped"
            exit 1
        fi
        ;;
    *)
        echo "usage: $0 [foreground|start|stop|status]" >&2
        exit 64
        ;;
esac
