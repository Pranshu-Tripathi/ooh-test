#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "$script_dir/../../.." && pwd)
kubectl_ooh="$script_dir/kubectl-ooh-test"
overlay_dir="$repository_root/k8s/overlays/docker-desktop-local-repositories"
configuration_file="$overlay_dir/repository-mount.env"
rollout_timeout="${OOH_K8S_ROLLOUT_TIMEOUT:-300s}"
deployments="worker-ingestion worker-generation worker-judging scheduler"
active_generations=""
migrations_complete=false

case "${1:-}" in
    "")
        ;;
    --migrations-complete)
        migrations_complete=true
        ;;
    *)
        echo "usage: $0 [--migrations-complete]" >&2
        exit 64
        ;;
esac

if [ ! -f "$configuration_file" ]; then
    echo "local repository mount configuration is missing: $configuration_file" >&2
    exit 1
fi

approved_root=$(
    sed -n 's/^OOH_K8S_REPOSITORY_HOST_ROOT=//p' "$configuration_file"
)
if [ -z "$approved_root" ]; then
    echo "OOH_K8S_REPOSITORY_HOST_ROOT is missing from $configuration_file" >&2
    exit 1
fi

if [ "$migrations_complete" = false ]; then
    "$script_dir/run-migrations"
fi

"$script_dir/local-repository-mount" status

for deployment in $deployments
do
    current_replicas=$(
        "$kubectl_ooh" get "deployment/$deployment" \
            -o jsonpath='{.spec.replicas}' 2>/dev/null || true
    )
    if [ "${current_replicas:-0}" -le 0 ]; then
        continue
    fi

    current_generation=$(
        "$kubectl_ooh" get "deployment/$deployment" \
            -o jsonpath='{.metadata.generation}'
    )
    active_generations="$active_generations $deployment:$current_generation"
done

"$kubectl_ooh" apply -k "$overlay_dir"

for generation_record in $active_generations
do
    deployment=${generation_record%%:*}
    previous_generation=${generation_record#*:}
    current_generation=$(
        "$kubectl_ooh" get "deployment/$deployment" \
            -o jsonpath='{.metadata.generation}'
    )
    if [ "$current_generation" = "$previous_generation" ]; then
        "$kubectl_ooh" rollout restart "deployment/$deployment"
    fi
done

for deployment in $deployments
do
    if ! "$kubectl_ooh" rollout status \
        "deployment/$deployment" \
        --timeout="$rollout_timeout"
    then
        "$kubectl_ooh" describe "deployment/$deployment" >&2 || true
        "$kubectl_ooh" get pods \
            -l "app.kubernetes.io/component=$deployment" \
            -o wide >&2 || true
        "$kubectl_ooh" logs "deployment/$deployment" \
            --all-pods=true \
            --tail=100 >&2 || true
        exit 1
    fi
done
