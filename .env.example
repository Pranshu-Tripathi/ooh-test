OOH_ENV=development
OOH_LOG_LEVEL=INFO
OOH_API_HOST=0.0.0.0
OOH_API_PORT=8500
OOH_API_HOST_PORT=8500
OOH_POSTGRES_HOST_PORT=8501
OOH_WORKER_POLL_INTERVAL_SECONDS=5
OOH_DATABASE_URL=postgresql://ooh:ooh@postgres:5432/ooh
OOH_CACHE_ROOT=/ooh_cache
OOH_REPOSITORY_MOUNT=.:/workspace:ro
OOH_MODEL_PROVIDER=ollama
OOH_OLLAMA_BASE_URL=http://host.docker.internal:11434
OOH_TEST_GENERATOR_MODEL=qwen3-coder:8b
OOH_ANSWER_JUDGE_MODEL=deepseek-r1:8b
POSTGRES_DB=ooh
POSTGRES_USER=ooh
POSTGRES_PASSWORD=ooh
